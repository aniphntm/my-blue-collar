# Public Privy app identifier (required for existing sign-in)
PRIVY_APP_ID=
# Server-only: enables verified embedded EVM wallet lookup
PRIVY_APP_SECRET=
# Server-only CDP Secret API key; ES256 PEM or base64 Ed25519 seed+public (64 bytes)
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
# Default sandbox; production must be selected explicitly
COINBASE_ONRAMP_MODE=sandbox
# Optional exact HTTPS origin, no trailing slash/path; never wildcard preview domains
FUNDING_PREVIEW_ORIGIN=

# Server-only: optional read-only Base ETH/USDC balances; never VITE_
ALCHEMY_API_KEY=
