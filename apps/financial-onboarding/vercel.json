{
  "version": 2,
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "onboard.mybluefinancial.com"
        }
      ],
      "dest": "/onboard.html"
    },
    {
      "src": "/login/?",
      "dest": "/login.html"
    },
    {
      "src": "/(?:create|signup|register)/?",
      "dest": "/create.html"
    },
    {
      "src": "/onboard/?",
      "status": 307,
      "headers": {
        "Location": "https://onboard.mybluefinancial.com/"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "has": [
        {
          "type": "host",
          "value": "onboard.mybluefinancial.com"
        }
      ],
      "dest": "/onboard.html"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "dist"
}
